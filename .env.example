# SpecRAG 环境变量配置模板
# 复制此文件为 .env 并按需修改

# ============================================================
# Flask 配置
# ============================================================

# 运行环境 (development/production)
FLASK_ENV=production

# 调试模式 (True/False)
DEBUG=False

# 服务器端口
PORT=5002

# 服务器主机
HOST=0.0.0.0

# ============================================================
# 数据库配置（可选）
# ============================================================

# Flask 页面数据默认使用本地 SQLite。
DATABASE_URL=sqlite:///data/specrag_app.db

# 知识库向量存储模式：默认 enterprise；本地小规模验证可改为 sqlite
KB_STORAGE_MODE=enterprise
KB_TENANT_ID=default

# 企业知识库存储：PostgreSQL 保存事实数据，Qdrant 保存向量索引
KB_POSTGRES_DB=specrag
KB_POSTGRES_USER=specrag
KB_POSTGRES_PASSWORD=specrag_dev
KB_POSTGRES_PORT=15432
KB_POSTGRES_DSN=postgresql://specrag:specrag_dev@127.0.0.1:15432/specrag
KB_QDRANT_URL=http://127.0.0.1:6333
KB_QDRANT_COLLECTION=specrag_units

# 本地 SQLite 知识库文件，仅 KB_STORAGE_MODE=sqlite 时使用
PRD_UNIT_KB_DB=data/specrag.db

# ============================================================
# 日志配置
# ============================================================

# 日志级别 (DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_LEVEL=INFO

# 日志文件路径
APP_LOG_FILE=logs/app.log

# ============================================================
# 模型配置
# ============================================================

# OpenAI-compatible 模型配置文件路径
AUTOGEN_CONFIG_PATH=config/OAI_CONFIG_LIST

# 向量模型配置。本地模型路径或 sentence-transformers 模型名。
PRD_UNIT_EMBEDDING_PROVIDER=sentence
PRD_UNIT_EMBEDDING_MODEL=runtime/models/qwen3-embedding-0.6b

# 上传文件大小限制（字节）
MAX_CONTENT_LENGTH=16777216
